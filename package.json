{
  "name": "lumiworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"node --watch server/index.mjs\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:drive": "node scripts/verify-drive.mjs",
    "arduino:ports": "node scripts/arduino-ports.mjs",
    "format": "prettier --write src server scripts tests",
    "verify:toyo": "node scripts/verify-toyo.mjs",
    "verify:firmware": "node scripts/verify-firmware.mjs",
    "verify:browser-serial": "node scripts/verify-browser-serial.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:market-search": "node scripts/verify-market-search.mjs",
    "verify:voice": "node scripts/verify-voice.mjs",
    "verify:reservations": "node scripts/verify-reservations.mjs",
    "verify:reservation-controls": "node scripts/verify-reservation-controls.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serialport": "^13.0.0",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
