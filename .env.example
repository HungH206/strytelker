GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3001

# Optional ElevenLabs narration (use a voice available to your account)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional USB Arduino button (find with npm run arduino:ports)
ARDUINO_PORT=

# Hosting: Render uses HOST=0.0.0.0. Leave unset for local-only access.
# HOST=0.0.0.0
# Vercel only: HTTPS origin of the deployed Render backend (no /api suffix).
# TOYO_BACKEND_URL=https://your-service.onrender.com

# Optional current-price/offer search; server-side only (Render for hosted use).
SERPAPI_API_KEY=

# Gemini Live seller voice; activated only by the Voice mode button.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore

# Private local SQLite customer reservation database. Use persistent storage when hosting.
RESERVATIONS_DB_PATH=.local/reservations.sqlite

# Tiger Cloud PostgreSQL URL; server-only. When set, reservation writes use Tiger Data.
# Obtain from Tiger Console > service > connection details. Never use a VITE_ prefix.
TIGER_DATABASE_URL=
# Optional CA certificate PEM if required by the service, with literal \n for newlines.
TIGER_CA_CERT=
# Required to enable /?monitor. Generate: openssl rand -hex 32
RESERVATION_ADMIN_TOKEN=
